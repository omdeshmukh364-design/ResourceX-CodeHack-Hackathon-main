# Official College Email Domain Restriction (strictly enforced on backend)
COLLEGE_EMAIL_DOMAINS=pcu.edu.in

# Firebase Project Configuration
FIREBASE_PROJECT_ID=resourcex-hackathon
# Path to Firebase Admin SDK service account JSON file (optional for local dev/testing)
FIREBASE_CREDENTIALS_PATH=credentials/service_account.json

# Administrative Bootstrap Secret (Used for one-time initial Admin creation)
ENABLE_ADMIN_BOOTSTRAP=false
ADMIN_BOOTSTRAP_KEY=

# Allowed Frontend Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Environment: development, test, or production
ENVIRONMENT=development

# Require Firebase email verification for Students (true in production)
REQUIRE_EMAIL_VERIFICATION=true

# Timezone standard
TIMEZONE=UTC
